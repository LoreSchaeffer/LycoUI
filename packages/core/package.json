{
  "name": "@loreschaeffer/lyco-ui",
  "version": "1.1.1",
  "description": "A dual-target UI component library for React and Vanilla HTML/CSS/JS",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LoreSchaeffer/LycoUI.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./vanilla": {
      "types": "./dist/types/vanilla.d.ts",
      "import": "./dist/vanilla.es.js",
      "require": "./dist/vanilla.cjs.js"
    },
    "./style.css": "./dist/lyco-ui.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -b --noEmit && vite build",
    "lint": "oxlint"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.73.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.101.0",
    "shiki": "^4.4.2",
    "typescript": "~7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3"
  }
}
