{
  "name": "lyco-ui-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:core": "npm run dev -w @loreschaeffer/lyco-ui",
    "dev:docs": "npm run dev -w lyco-ui-docs",
    "typecheck": "node node_modules/typescript/bin/tsc -p packages/core/tsconfig.app.json --noEmit --incremental false",
    "test:unit": "vitest run",
    "test:parity": "playwright test",
    "audit:contracts": "node scripts/audit-contracts.mjs",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/typescript-estree": "^8.72.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9",
    "sass": "^1.106.1",
    "vitest": "^5.0.5"
  }
}
